use std.test {assert-eq assert-true test summarize}
use std.http :as http
use std.env :as env
use neo4irij :as neo
use neo4irij.bolt :as bolt

;; Against a real server, every scenario over HTTP and again over Bolt.
;; Skipped unless NEO4J_URI is set, e.g.
;;
;;   docker run -d --rm -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/password123 neo4j:latest
;;   NEO4J_URI=http://localhost:7474 NEO4J_USERNAME=neo4j NEO4J_PASSWORD=password123 irij test
;;
;; NEO4J_BOLT_URI names the Bolt endpoint when it isn't NEO4J_URI's
;; host at port 7687. Writes only nodes labelled :Neo4irijTest, and
;; deletes them.

fn clean :: neo.Conn () ::: neo.Neo4j
  => conn
  neo.execute conn "MATCH (n:Neo4irijTest) DETACH DELETE n" {}
  ()

fn caught :: (Fn):eff _ ::: eff
  => thunk
  match (try thunk)
    Ok v => error ~ "expected a failure, got " ++ to-str v
    Err e => e

fn run-info :: neo.Conn () ::: neo.Neo4j
  => conn
  i := neo.info conn
  assert-true (contains? i "neo4j_version")

fn run-params-round-trip :: neo.Conn () ::: neo.Neo4j
  => conn
  v := {s= "héllo" i= 9223372036854775807 f= 0.1 b= true nul= () xs= #[1 "two" #[3]] m= {k= 2}}
  assert-eq v (neo.scalar conn "RETURN $v AS v" {v= v})
  assert-eq "kw" (neo.scalar conn "RETURN $v AS v" {v= :kw})
  assert-eq 0.5 (neo.scalar conn "RETURN $v AS v" {v= 1/2})
  assert-eq #[1 2] (neo.scalar conn "RETURN $v AS v" {v= #(1 2)})

fn run-tagged-round-trip :: neo.Conn () ::: neo.Neo4j
  => conn
  d := neo.date "2024-05-06"
  assert-eq d (neo.scalar conn "RETURN $v AS v" {v= d})
  assert-eq "2025-05-06" (neo.scalar conn "RETURN toString($v + duration('P1Y')) AS v" {v= d})
  du := neo.duration "P1DT2H"
  assert-eq du (neo.scalar conn "RETURN $v AS v" {v= du})
  z := neo.datetime "2024-05-06T10:00:00+02:00[Europe/Berlin]"
  assert-eq z (neo.scalar conn "RETURN $v AS v" {v= z})
  p := neo.wgs84 13.4 52.5
  assert-eq 13.4 (neo.scalar conn "RETURN $v.longitude AS v" {v= p})
  assert-eq "Date" (neo.scalar conn "RETURN date('2020-01-01') AS v" {}).kind

fn run-graph-entities :: neo.Conn () ::: neo.Neo4j
  => conn
  clean conn
  c := neo.execute conn "CREATE (:Neo4irijTest:Person {name: 'Ada'})-[:KNOWS {since: 1843}]->(:Neo4irijTest:Person {name: 'Charles'})" {}
  assert-eq 2 (get "nodes-created" c)
  assert-eq 1 (get "relationships-created" c)
  row := neo.single conn "MATCH p = (a:Neo4irijTest {name: 'Ada'})-[r:KNOWS]->(b) RETURN a, r, b, p" {}
  a := get "a" row
  r := get "r" row
  b := get "b" row
  assert-eq "Node" (type-of a)
  assert-true (contains? a.labels "Person")
  assert-eq "Ada" (get "name" a.props)
  assert-eq "KNOWS" r.type
  assert-eq 1843 (get "since" r.props)
  assert-eq a.id r.start
  assert-eq b.id r.end
  path := get "p" row
  assert-eq #["Ada" "Charles"] (path.nodes |> @ (n -> get "name" n.props))
  assert-eq 1 (length path.rels)
  clean conn

fn run-transaction-commit :: neo.Conn () ::: neo.Neo4j
  => conn
  clean conn
  n := neo.transaction conn (tx -> get "nodes-created" (neo.execute tx "CREATE (:Neo4irijTest {k: 1}), (:Neo4irijTest {k: 2})" {}))
  assert-eq 2 n
  assert-eq 2 (neo.scalar conn "MATCH (n:Neo4irijTest) RETURN count(n)" {})
  clean conn

fn create-then-fail :: neo.Tx _ ::: neo.Neo4j
  => tx
  neo.execute tx "CREATE (:Neo4irijTest {k: 3})" {}
  assert-eq 1 (neo.scalar tx "MATCH (n:Neo4irijTest) RETURN count(n)" {})
  error "abandon"

fn run-transaction-rollback :: neo.Conn () ::: neo.Neo4j
  => conn
  clean conn
  assert-eq "abandon" (caught (-> neo.transaction conn create-then-fail))
  assert-eq 0 (neo.scalar conn "MATCH (n:Neo4irijTest) RETURN count(n)" {})

fn create-then-bad-cypher :: neo.Tx _ ::: neo.Neo4j
  => tx
  neo.execute tx "CREATE (:Neo4irijTest {k: 4})" {}
  neo.execute tx "CREAT oops" {}

fn run-server-side-failure-in-tx :: neo.Conn () ::: neo.Neo4j
  => conn
  clean conn
  e := caught (-> neo.transaction conn create-then-bad-cypher)
  assert-eq "Neo.ClientError.Statement.SyntaxError" e.code
  assert-eq 0 (neo.scalar conn "MATCH (n:Neo4irijTest) RETURN count(n)" {})

fn run-errors :: neo.Conn () ::: neo.Neo4j
  => conn
  e1 := caught (-> neo.query conn "MATC (n) RETURN n" {})
  assert-eq "Neo.ClientError.Statement.SyntaxError" e1.code
  assert-true (e1.status == 400 || e1.status == 0)
  e2 := caught (-> neo.execute (neo.read-only conn) "CREATE (:Neo4irijTest)" {})
  assert-eq "Neo.ClientError.Statement.AccessMode" e2.code
  e3 := caught (-> neo.query (neo.use-database conn "no-such-db") "RETURN 1" {})
  assert-eq "Neo.ClientError.Database.DatabaseNotFound" e3.code
  e4 := caught (-> neo.query conn "RETURN $missing AS x" {})
  assert-true (starts-with? e4.code "Neo.ClientError.Statement.")

fn run-bookmarks :: neo.Conn () ::: neo.Neo4j
  => conn
  r := neo.run conn "CREATE (n:Neo4irijTest) RETURN elementId(n) AS i" {}
  assert-true (length r.bookmarks > 0)
  after := neo.with-bookmarks conn r.bookmarks
  assert-true (neo.scalar after "MATCH (n:Neo4irijTest) RETURN count(n) > 0" {})
  clean conn

fn run-bytes :: neo.Conn () ::: neo.Neo4j
  => conn
  b := neo.bytes "AQID/w=="
  assert-eq b (neo.scalar conn "RETURN $v AS v" {v= b})
  assert-eq 4 (neo.scalar conn "RETURN size($v) AS v" {v= b})

fn run-concurrent :: neo.Conn () ::: neo.Neo4j
  => conn
  clean conn
  neo.execute conn "UNWIND range(1, 20) AS i CREATE (:Neo4irijTest {i: i})" {}
  sums := par (a b c -> #[a b c]) (-> neo.scalar conn "MATCH (n:Neo4irijTest) RETURN sum(n.i)" {}) (-> neo.scalar conn "MATCH (n:Neo4irijTest) WHERE n.i <= 10 RETURN sum(n.i)" {}) (-> neo.scalar conn "MATCH (n:Neo4irijTest) RETURN count(n)" {})
  assert-eq #[210 55 20] sums
  clean conn

fn live :: neo.Conn Fn Fn ::: http.Http
  (conn f -> (-> with http.default-http do (with neo.default-neo4j do (f conn))))

fn live-bolt :: neo.Conn Fn Fn ::: neo.Neo4j
  (conn f -> (-> with bolt.neo4j do (f conn)))

;; ── Bolt only ────────────────────────────────────────────────────

fn read-both :: neo.Conn Str _ ::: http.Http neo.Neo4j
  => conn cypher
  over-http := with http.default-http do (with neo.default-neo4j do (neo.single conn cypher {}))
  over-bolt := with bolt.neo4j do (neo.single conn cypher {})
  #(over-http over-bolt)

;; One server, two transports, the same values — down to the text of
;; each temporal, spatial and duration value.
fn run-same-values :: neo.Conn () ::: http.Http neo.Neo4j
  => conn
  cypher := "RETURN 1 AS i, 1.5 AS f, 'é' AS s, true AS b, null AS n, [1, [2, 'x']] AS l, {k: {j: 1}} AS m, "
    ++ "date('2024-05-06') AS d, time('10:00:00.5+01:00') AS t, localtime('10:00') AS lt, "
    ++ "localdatetime('2024-05-06T10:00:00.873') AS ldt, datetime('2024-05-06T10:00:00Z') AS o, "
    ++ "datetime('2024-05-06T10:00:00+02:00[Europe/Berlin]') AS z, "
    ++ "duration('P1Y2M3DT4H5M6.5S') AS d1, duration('PT0S') AS d2, duration('-P1DT1H') AS d3, duration('PT-0.5S') AS d4, "
    ++ "point({x: 1, y: 2}) AS p2, point({x: 1, y: 2, z: 3}) AS p3, point({longitude: 13.4, latitude: 52.5}) AS geo"
  #(h b) := read-both conn cypher
  keys h |> @ (k -> assert-eq (get k h) (get k b))
  assert-eq (length (keys h)) (length (keys b))

fn run-same-entities :: neo.Conn () ::: http.Http neo.Neo4j
  => conn
  with bolt.neo4j do (clean conn)
  with bolt.neo4j do (neo.execute conn "CREATE (:Neo4irijTest:Person {name: 'Ada', born: date('1815-12-10')})-[:KNOWS {since: 1843}]->(:Neo4irijTest {name: 'Charles'})" {})
  #(h b) := read-both conn "MATCH p = (a:Neo4irijTest {name: 'Ada'})-[r]->(c) RETURN a, r, c, p"
  assert-eq h b
  with bolt.neo4j do (clean conn)

fn run-bolt-failures :: neo.Conn () ::: neo.Neo4j
  => conn
  wrong := neo.connect {url= conn.url bolt-url= conn.bolt user= "neo4j" password= "not-the-password"}
  e1 := caught (-> with bolt.neo4j do (neo.query wrong "RETURN 1" {}))
  assert-eq "Neo.ClientError.Security.Unauthorized" e1.code
  assert-eq 0 e1.status
  with bolt.neo4j do (neo.close wrong)
  nowhere := neo.connect {bolt-url= "neo4j://localhost:1"}
  e2 := caught (-> with bolt.neo4j do (neo.query nowhere "RETURN 1" {}))
  assert-eq "neo4irij.Unavailable" e2.code
  assert-true (neo.transient? e2)
  with bolt.neo4j do (neo.close nowhere)

fn run-close-and-reopen :: neo.Conn () ::: neo.Neo4j
  => conn
  with bolt.neo4j
    assert-eq 1 (neo.scalar conn "RETURN 1" {})
    neo.close conn
    neo.close conn
    assert-eq 2 (neo.scalar conn "RETURN 2" {})

uri := get-env "NEO4J_URI"
skip := uri == () || uri == ""
if skip
  println "  [skip] NEO4J_URI not set — live tests skipped"
conn := if skip (neo.connect {}) else (with env.default-env do (neo.connect-env ()))

;; Every scenario, once per transport.
scenarios := #[
  #("info"                                 run-info)
  #("parameters round-trip"                run-params-round-trip)
  #("temporal/spatial round-trip"          run-tagged-round-trip)
  #("bytes round-trip"                     run-bytes)
  #("nodes, relationships, paths"          run-graph-entities)
  #("transaction commits"                  run-transaction-commit)
  #("transaction rolls back on error"      run-transaction-rollback)
  #("server-side failure inside a tx"      run-server-side-failure-in-tx)
  #("Neo4j errors surface as Neo4jError"   run-errors)
  #("bookmarks"                            run-bookmarks)
  #("concurrent statements"                run-concurrent)
]

results := if skip
  #[]
else
  over-http := scenarios |> @ (#(name f) -> test ("[http] " ++ name) (live conn f))
  over-bolt := scenarios |> @ (#(name f) -> test ("[bolt] " ++ name) (live-bolt conn f))
  bolt-only := #[
    (test "[both] same values over HTTP and Bolt"     (-> run-same-values conn))
    (test "[both] same nodes, rels, paths"            (-> run-same-entities conn))
    (test "[bolt] bad password, no server"            (-> run-bolt-failures conn))
    (test "[bolt] close, then a new driver"           (-> run-close-and-reopen conn))
  ]
  with bolt.neo4j do (neo.close conn)
  over-http ++ over-bolt ++ bolt-only

summarize results
